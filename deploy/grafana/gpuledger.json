{
  "uid": "gpuledger",
  "title": "gpuledger — who holds which GPU",
  "description": "The ledger of every node's GPUs: states, findings, the driver's view. From gpuledger serve's /metrics.",
  "tags": [
    "gpuledger",
    "gpu",
    "nomad"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpuledger_up, node)",
          "refId": "node"
        },
        "definition": "label_values(gpuledger_up, node)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Worst finding per node",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_worst_level{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "WARN",
                  "color": "yellow"
                },
                "2": {
                  "text": "BAD",
                  "color": "red"
                },
                "3": {
                  "text": "ERROR",
                  "color": "dark-purple"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              },
              {
                "color": "dark-purple",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "gpuledger check's verdict per node: the level of the worst finding."
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "GPUs by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (gpuledger_gpu_state{node=~\"$node\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Every GPU is exactly one of free, reserved-idle, held, unaccounted."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sources read",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_up{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "partial",
                  "color": "red"
                },
                "1": {
                  "text": "ok",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "description": "0 while nvidia-smi, Docker or Nomad cannot be read; /healthz on the node names the source."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Findings by code",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (code) (gpuledger_findings{node=~\"$node\",code!~\"idle|held\"})",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Reserved and idle for",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - gpuledger_gpu_state_since_timestamp_seconds{node=~\"$node\",state=\"reserved-idle\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "How long each reserved GPU has had nothing on it. Needs serve --history."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_utilization_percent{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_memory_used_bytes{node=~\"$node\"} / gpuledger_gpu_memory_total_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Encoder sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_encoder_sessions{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "NVENC sessions. Unrestricted on Quadro RTX 4000, L4, T4, A10 — a count here is load, not a limit."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Temperature and thermal margin",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_temperature_celsius{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}} temp"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_thermal_margin_celsius{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}} margin"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {},
      "description": "The margin is the driver's: degrees left before the card's own slowdown temperature."
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Thermal slowdown",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_gpu_thermal_slowdown{node=~\"$node\"}",
          "legendFormat": "{{node}} gpu{{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU memory by tenant",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node, kind, nomad_job, container) (gpuledger_tenant_memory_bytes{node=~\"$node\"})",
          "legendFormat": "{{node}} {{kind}} {{nomad_job}}{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "table",
      "title": "Nomad tenants not reserved",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gpuledger_tenant_reserved{node=~\"$node\",kind=\"nomad\"} == 0",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Nomad tasks holding a GPU Nomad did not allocate to them."
    },
    {
      "id": 13,
      "type": "table",
      "title": "GPU-hours per job over the range",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, nomad_job, use) (increase(gpuledger_job_gpu_seconds_total{node=~\"$node\"}[$__range])) / 3600",
          "legendFormat": "{{namespace}}/{{nomad_job}} {{use}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "What each job had reserved over the dashboard's time range: held by its allocation, or idle. gpuledger report prints the same."
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Idle share per job",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, nomad_job) (increase(gpuledger_job_gpu_seconds_total{node=~\"$node\",use=\"idle\"}[$__range])) / sum by (namespace, nomad_job) (increase(gpuledger_job_gpu_seconds_total{node=~\"$node\"}[$__range]))",
          "legendFormat": "{{namespace}}/{{nomad_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "The share of each job's reserved GPU time nothing ran on. GPULedgerJobMostlyIdle fires over half, on a day."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GPUs in each state, from the counters",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (state) (rate(gpuledger_gpu_state_seconds_total{node=~\"$node\"}[5m]))",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "The average number of GPUs in each state — the rate of the state counters, so a restart of serve does not break it."
    }
  ]
}
